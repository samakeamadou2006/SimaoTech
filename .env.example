# =============================================================================
# SimaoTech - variables d'environnement
# Copier ce fichier vers .env puis renseigner les valeurs reelles.
# Ne jamais committer .env. Ne jamais exposer ces secrets au frontend.
# =============================================================================

# --- Serveur Node/Express -----------------------------------------------------
NODE_ENV=development
PORT=3000
URL_PUBLIQUE=http://localhost:3000
# Origines autorisees pour l'API (liste separee par des virgules)
ORIGINES_AUTORISEES=http://localhost:3000,http://localhost:5173
# Fuseau de reference metier (XOF / Cote d'Ivoire)
FUSEAU_HORAIRE=Africa/Abidjan

# --- PostgreSQL ---------------------------------------------------------------
# Supabase : Project Settings > Database > Connection string (pooler).
# En local : postgresql://postgres:motdepasse@localhost:5432/simaotech
DATABASE_URL=
# Supabase exige TLS. Mettre true en production / cloud, false en local.
BASE_DE_DONNEES_SSL=true
# Taille maximale du pool de connexions
POOL_MAX=10

# --- Supabase -----------------------------------------------------------------
# URL du projet : https://xxxxx.supabase.co
SUPABASE_URL=
# Cle publique (anon) : utilisee UNIQUEMENT pour verifier les jetons d'acces.
SUPABASE_CLE_ANON=
# Cle service_role : usage exclusivement backend (migrations, taches admin).
# ATTENTION : contourne RLS. Ne jamais l'envoyer au navigateur.
SUPABASE_CLE_SERVICE=

# --- Authentification ---------------------------------------------------------
# Mode de verification des jetons : "supabase" (production) ou "local" (developpement,
# verification d'une signature HS256 avec le secret ci-dessous).
MODE_AUTH=supabase
# Supabase : Project Settings > API > JWT Secret (mode local uniquement)
JWT_SECRET=
# Duree de vie maximale acceptee d'un jeton, en secondes (8 h)
JWT_DUREE_MAX=28800

# --- Divers -------------------------------------------------------------------
# Longueur minimale des mots de passe crees via l'API d'administration
MOT_DE_PASSE_LONGUEUR_MIN=10
# Dossier des journaux techniques
DOSSIER_JOURNAUX=journaux
NIVEAU_JOURNAL=info
